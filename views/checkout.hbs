<div class='row justify-content-center'>
  <div class='col-md-6'>
    {{#unless error}}
      <div class='mt-20'>
        <a class='text-secondary' href='/'><i class='fas fa-arrow-left'></i> Back to books</a>
      </div>
      <div class='text-center mt-40'>
        <h1>Checkout — {{ appName }}</h1>
        <h5 class='text-secondary'>{{ title }}</h5>
        <hr class='mt-40' />
        <div class='mt-20 text-info'>
          Total due: $
          <span class='amount' data-amount='{{ amount }}'></span>
        </div>
      </div>
      <div class='d-flex justify-content-end align-items-center mt-40 mb-2'>
        <span class='text-secondary small mr-2'>Theme</span>
        <div
          id='appearance-toggle'
          class='btn-group btn-group-sm'
          role='group'
          aria-label='Payment form theme'
        >
          <button
            class='btn btn-outline-secondary active'
            type='button'
            data-theme='stripe'
            aria-pressed='true'
          >
            Stripe
          </button>
          <button
            class='btn btn-outline-secondary'
            type='button'
            data-theme='flat'
            aria-pressed='false'
          >
            Flat
          </button>
          <button
            class='btn btn-outline-secondary'
            type='button'
            data-theme='night'
            aria-pressed='false'
          >
            Night
          </button>
        </div>
      </div>
      <div id='checkout-card' class='card box-shadow'>
        <div class='card-body'>
          <form
            id='payment-form'
            name='payment-form'
            data-publishable-key='{{ publishableKey }}'
            data-book-id='{{ bookId }}'
          >
            <div>
              <label for='email'>Email address</label>
              <input
                id='email'
                class='form-control'
                type='email'
                name='email'
                placeholder='you@email.com'
                required
              />
            </div>
            <div id='payment-element' class='mt-20'></div>
            <div id='payment-message' class='mt-20 text-danger' role='alert'></div>
            <div class='mt-20'>
              <button id='submit' class='btn btn-lg btn-block btn-primary' type='submit'>
                Pay $
                <span class='amount' data-amount='{{ amount }}'></span>
              </button>
            </div>
          </form>
        </div>
      </div>
      <script src='/js/checkout.js'></script>
    {{else}}
      <div class='mt-40 text-center'>
        <a class='btn btn-outline-primary' href='/'>Back to the store</a>
      </div>
    {{/unless}}
  </div>
</div>
