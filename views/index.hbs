<div class='text-center mt-40'>
  <h1>Shop: {{ appName }}</h1>
  <p class='text-secondary'>Select an item to purchase</p>
</div>
<div class='mt-40 row'>
  {{#each books}}
    <div class='col-md'>
      <div class='card box-shadow mb-4'>
        <img class='card-img-top' src='{{ image }}' alt='Cover of {{ title }}' />
        <div class='card-body'>
          <form action='/checkout' method='get'>
            <input type='hidden' name='bookId' value='{{ @key }}' />
            <button class='btn btn-primary btn-block' type='submit'>
              Purchase — $
              <span class='amount' data-amount='{{ amount }}'></span>
            </button>
          </form>
        </div>
      </div>
    </div>
  {{/each}}
</div>
