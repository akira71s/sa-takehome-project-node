<div class='text-center mt-40'>
  <h1>Shop: {{ appName }}</h1>
  <p class='text-secondary'>Select an item to purchase</p>
</div>
<div class='mt-40 row'>
  {{#each books}}
    <div class='col-md'>
      <div class='card box-shadow mb-4'>
        <img class='card-img-top' src='{{ image }}' alt='Cover of {{ title }}' />
        <div class='card-body'>
          <h5 class='card-title'>{{ title }}</h5>
          <strong>{{ author }}</strong>
          <p class='card-text mt-20'>{{ description }}</p>
          <a class='btn btn-primary btn-block' href='/checkout?bookId={{ @key }}'>
            Purchase — $
            <span class='amount' data-amount='{{ amount }}'></span>
          </a>
        </div>
      </div>
    </div>
  {{/each}}
</div>
