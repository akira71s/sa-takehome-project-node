<div class='row justify-content-center'>
  <div class='col-md-6'>
    {{#if paid}}
      <div class='text-center mt-40'>
        <div class='success-icon'>
          <i class='fas fa-check'></i>
        </div>
        <h1 class='mt-20'>Thank you for your order!</h1>
        <p class='text-secondary'>
          Your payment was successful.
          {{#if email}}
            Confirmation for
            <strong>
              {{ email }}
            </strong>
            .
          {{/if}}
        </p>
      </div>

      <div class='card box-shadow mt-40'>
        <div class='card-body'>
          <div class='media mb-3'>
            <img
              class='receipt-cover mr-3'
              src='{{ book.image }}'
              alt='Cover of {{ book.title }}'
            />
            <div class='media-body'>
              <h5 class='mb-1'>{{ book.title }}</h5>
              <small class='text-secondary'>Qty 1</small>
            </div>
          </div>

          <dl class='receipt'>
            <dt>Date</dt>
            <dd>{{ date }}</dd>
            <dt>Total paid</dt>
            <dd>
              <strong>$<span class='amount' data-amount='{{ amount }}'></span></strong>
            </dd>
            <dt>Payment ID</dt>
            <dd>
              <code>{{ paymentIntentId }}</code>
              <button
                class='btn btn-sm btn-link p-0 ml-2'
                type='button'
                onclick="
                  navigator.clipboard.writeText('{{ paymentIntentId }}').then(() => {
                                          this.textContent = 'Copied!';
                                          setTimeout(() => { this.textContent = 'Copy'; }, 2000);
                                        })
                "
              >
                Copy
              </button>
            </dd>
          </dl>
        </div>
      </div>
    {{else if failed}}
      <div class='mt-40 text-center'>
        <h1 class='text-danger'>
          <i class='fas fa-times-circle'></i>
          Payment failed
        </h1>
        <p class='mt-20 text-secondary'>
          Your payment couldn't be completed, and you haven't been charged.
        </p>
        <a class='btn btn-outline-primary' href='/checkout?bookId={{ bookId }}'>Try again</a>
      </div>
    {{else}}
      <div class='mt-40 text-center text-secondary'>
        <h1>
          <i class='far fa-clock'></i>
          Payment processing
        </h1>
        <p class='mt-20'>
          Your payment is being confirmed. Refresh this page in a few minutes to check the status.
        </p>
      </div>
    {{/if}}

    <div class='mt-40 text-center'>
      <a class='btn btn-primary' href='/'>Continue shopping</a>
    </div>
  </div>
</div>
